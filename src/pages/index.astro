---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: var(--container-extra-wide);
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;
			}
			.contact-button {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 2rem;
				padding: 0.75rem 1.5rem;
				background: var(--accent);
				color: white;
				text-decoration: none;
				border-radius: 8px;
				font-weight: 600;
				transition: all 0.3s ease;
				box-shadow: 0 2px 8px rgba(var(--accent-dark), 0.2);
			}
			.contact-button:hover {
				background: var(--accent-dark);
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(var(--accent-dark), 0.3);
			}
			.contact-button svg {
				width: 20px;
				height: 20px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<br>
			<h1>Vaishakh G K</h1>
			<h3><b>Software Engineer . Security Engineer</h3>
			<br>
			<h4>Go · C · Linux · Networking · Web</h4>
			<br>

			<div class="intro">
				<p>
					I'm a backend developer with experience building web applications,
					APIs, and distributed systems,<br> with a growing focus on cybersecurity
					and security engineering.
				</p>

				<p>
					My software engineering background helps me understand security from
					both sides — how applications<br> and backend systems are built, and how
					they can be analyzed, tested, and secured.
				</p>

				<p>
					I'm currently exploring Linux, networking, wireless security,
					low-level programming, and application securit:<br> while building
					security-focused projects and documenting what I learn through
					technical writing.
				</p>
			</div>

			<a href="mailto:vaishakh@vaishakhgk.com" class="contact-button">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
					<polyline points="22,6 12,13 2,6"></polyline>
				</svg>
				Contact Me
			</a>
			</main>
		<Footer />
	</body>
</html>
